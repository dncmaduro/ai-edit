PROJECT_ROOT=/Volumes/Transcend/ai-edit
WHISPER_MODEL=mlx-community/whisper-large-v3-turbo
# Optional: path to the Python executable whose environment has mlx-whisper installed.
# WHISPER_PYTHON=python3
# Optional: path to the Python executable whose environment has PySceneDetect installed.
# SCENEDETECT_PYTHON=python3
# Optional ContentDetector tuning values.
# SCENEDETECT_THRESHOLD=27
# SCENEDETECT_MIN_SCENE_SECONDS=0.8

# Server-side Gemini semantic analysis (M5).
GEMINI_API_KEY=
GEMINI_ANALYSIS_MODEL=gemini-3.5-flash-lite
# GEMINI_ANALYSIS_CONCURRENCY=3
